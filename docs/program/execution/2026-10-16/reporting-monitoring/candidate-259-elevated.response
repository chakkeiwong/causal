            });
            -
            $("#article_information").click(function(){
                
              if(   $(this).find('div').hasClass('rotate90') ){
                  $(this).find('div').removeClass('rotate90');
                  $('#affiliation').hide();
              }else{
                  $(this).find('div').addClass('rotate90');
                  $('#affiliation').show();   
              }
            });  
           
           

              });
 


</script>
</body>
</html>