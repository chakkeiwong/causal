{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "causalbank.response/1.0.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "enum": [
        "problem.formulate",
        "graph.review",
        "graph.discover",
        "identify.effect",
        "design.evaluate",
        "estimate.effect",
        "sensitivity.evaluate",
        "audit.observation",
        "report.build",
        "capabilities.describe",
        "job.status",
        "job.cancel"
      ]
    },
    "status": {
      "enum": [
        "completed",
        "queued",
        "running",
        "cancelled",
        "failed",
        "rejected"
      ]
    },
    "disposition": {
      "enum": [
        "computed",
        "not_identified",
        "unsupported",
        "unavailable",
        "refused",
        "not_applicable"
      ]
    },
    "context_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "result": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "effect",
                "problem_candidates",
                "graph",
                "identification",
                "diagnostics",
                "report",
                "capabilities",
                "job"
              ]
            },
            "estimate": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "coordinate_sets": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "topology": {
                        "enum": [
                          "finite_interval",
                          "finite_union",
                          "unbounded_union",
                          "whole_line",
                          "empty",
                          "unknown"
                        ]
                      },
                      "intervals": {
                        "anyOf": [
                          {
                            "type": "array",
                            "items": {
                              "type": "array",
                              "prefixItems": [
                                {
                                  "type": [
                                    "number",
                                    "null"
                                  ]
                                },
                                {
                                  "type": [
                                    "number",
                                    "null"
                                  ]
                                }
                              ],
                              "minItems": 2,
                              "maxItems": 2
                            }
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "topology",
                      "intervals"
                    ],
                    "additionalProperties": false
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "units": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "uncertainty": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "pointwise_confidence",
                        "joint_confidence",
                        "posterior_credible",
                        "sensitivity"
                      ]
                    },
                    "coverage": {
                      "enum": [
                        "pointwise",
                        "simultaneous",
                        "posterior",
                        "none"
                      ]
                    },
                    "level": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "sampling_law": {
                      "type": "string",
                      "minLength": 1
                    },
                    "assumptions": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "numerical_error": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "construction_evidence": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "artifact_id": {
                            "type": "string",
                            "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                          },
                          "sha256": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          },
                          "media_type": {
                            "type": "string",
                            "minLength": 1
                          },
                          "schema_version": {
                            "type": "string",
                            "minLength": 1
                          },
                          "role": {
                            "type": "string",
                            "minLength": 1
                          },
                          "bytes": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "custody": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "artifact_id",
                          "sha256",
                          "media_type",
                          "schema_version",
                          "role",
                          "bytes",
                          "custody"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "kind",
                    "coverage",
                    "level",
                    "sampling_law",
                    "assumptions",
                    "numerical_error",
                    "construction_evidence"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "payload": {
              "type": "object"
            }
          },
          "required": [
            "kind",
            "estimate",
            "coordinate_sets",
            "units",
            "uncertainty",
            "payload"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "schema_version": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "custody": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "artifact_id",
          "sha256",
          "media_type",
          "schema_version",
          "role",
          "bytes",
          "custody"
        ],
        "additionalProperties": false
      }
    },
    "qualification": {
      "type": "object",
      "properties": {
        "level": {
          "enum": [
            "none",
            "execution_only",
            "conditional_inference",
            "qualified_in_declared_scope",
            "externally_accepted"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "artifact_id": {
                "type": "string",
                "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "media_type": {
                "type": "string",
                "minLength": 1
              },
              "schema_version": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "custody": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "artifact_id",
              "sha256",
              "media_type",
              "schema_version",
              "role",
              "bytes",
              "custody"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "level",
        "evidence"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "operation",
    "status",
    "disposition",
    "context_sha256",
    "result",
    "error",
    "evidence",
    "qualification"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:causalbank:response:1.0.0"
}
