{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "study 0.1.0",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "population_ref": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decision_unit": {
      "type": "string",
      "minLength": 1
    },
    "assignment_unit": {
      "type": "string",
      "minLength": 1
    },
    "horizon_days": {
      "type": "integer",
      "minimum": 1
    },
    "estimand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "treatment_ref": {
          "type": "string",
          "minLength": 1
        },
        "comparator_ref": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "treatment_minus_comparator",
            "historical_minus_perfect_execution"
          ]
        },
        "outcome_ref": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "name",
        "treatment_ref",
        "comparator_ref",
        "direction",
        "outcome_ref",
        "currency"
      ]
    },
    "identification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "route": {
          "enum": [
            "randomized",
            "adjustment",
            "panel",
            "sequential",
            "proximal",
            "structural",
            "partial"
          ]
        },
        "assumption_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": [
            "proposed",
            "reviewed_under_assumptions",
            "not_identified"
          ]
        }
      },
      "required": [
        "route",
        "assumption_ids",
        "status"
      ]
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sampling_design": {
          "type": "string",
          "minLength": 1
        },
        "fold_unit": {
          "type": "string",
          "minLength": 1
        },
        "cluster_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evaluation_mode": {
          "enum": [
            "retrospective",
            "prospective"
          ]
        }
      },
      "required": [
        "sampling_design",
        "fold_unit",
        "cluster_keys",
        "evaluation_mode"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "study_id",
    "population_ref",
    "snapshot_sha256",
    "decision_unit",
    "assignment_unit",
    "horizon_days",
    "estimand",
    "identification",
    "inference",
    "source_refs"
  ]
}
