{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "graph 0.1.0",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "graph_id": {
      "type": "string",
      "minLength": 1
    },
    "graph_type": {
      "enum": [
        "DAG",
        "CPDAG",
        "PAG",
        "temporal_PAG"
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "lag": {
            "type": "integer",
            "minimum": 0
          },
          "source_endpoint": {
            "enum": [
              "tail",
              "arrow",
              "circle"
            ]
          },
          "target_endpoint": {
            "enum": [
              "tail",
              "arrow",
              "circle"
            ]
          }
        },
        "required": [
          "source",
          "target",
          "lag",
          "source_endpoint",
          "target_endpoint"
        ]
      }
    },
    "assumption_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "data_snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "discovery_method": {
      "type": "string",
      "minLength": 1
    },
    "max_lag": {
      "type": "integer",
      "minimum": 0
    },
    "role": {
      "enum": [
        "hypothesis",
        "accepted_study_assumption"
      ]
    }
  },
  "required": [
    "schema_version",
    "graph_id",
    "graph_type",
    "nodes",
    "edges",
    "assumption_ids",
    "data_snapshot_sha256",
    "discovery_method",
    "max_lag",
    "role"
  ]
}
