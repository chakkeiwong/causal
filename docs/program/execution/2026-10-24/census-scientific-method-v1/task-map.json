  "primary_application_notes": {
    "business_translation": "Use claim-level provenance and operational targets; proposed graph links stay hypotheses.",
    "iid_discovery": "Graph voting supports candidate generation, not identified effects or calibrated graph probabilities; preserve equivalence and latent endpoints.",
    "agent_architecture": "Use explicit input-ablation and abstention contracts.",
    "evaluation_cost": "Use paired seed-level gold judgments; report filtering,macro/micro weights,refusals and decision economics.",
    "estimation_validation": "A prompt experiment must distinguish observed grades from calibrated semantic correctness.",
    "expert_evidence": "Keep ancestry and adjacency questions separate; audit expert accuracy on selected queries and all physical calls.",
    "active_experiments": "Validate generated hypotheses with held-out mechanisms before expensive bank intervention evidence.",
    "ace_bowtie": "Separate text-supported roles and expert-added hypotheses; preserve missing roles and known-mechanism evaluation.",
    "causal_prophets": "Formal known-probability tasks and generated-data tool use do not test business translation, discovery on bank data or identification from authentic observational records."
  },
