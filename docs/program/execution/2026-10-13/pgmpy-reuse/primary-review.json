  "findings": [
    {
      "id": "IMPLEMENTATION-NOT-GUIDE",
      "finding": "minimal_variance is advertised but the pinned _identify branch raises NotImplementedError; exclude this operation at this pin."
    },
    {
      "id": "DESCENDANT-VALIDATION",
      "finding": "BaseGraphicalIdentification validates type and role presence; role validation does not check causal admissibility. Adjustment._validate checks parents of exposures. With root X in X->M->Y it returns all(empty)=True even when adjustment={M}. Add independent descendant and strict backdoor checks for the proposed total-effect path. This is a static source trace, not an installed-engine result."
    },
    {
      "id": "MINIMAL-NOT-MINIMUM",
      "finding": "DAG.minimal_dseparator greedily deletes dispensable variables. Do not promise globally minimum cardinality or variance based on the word minimal or the docstring smallest. Multiple inclusion-minimal sets can have different sizes."
    },
    {
      "id": "ONE-DAG-IS-NOT-CLASS",
      "finding": "PC pdag/cpdag return the same partially directed object; dag calls to_dag. PDAG.to_dag may warn and orient arbitrarily if consistent extension fails. to_cpdag calls this conversion. Never use conversion alone to certify valid equivalence-class semantics."
    },
    {
      "id": "ALL-IS-BOUNDED",
      "finding": "The all branch enumerates subsets of an ancestor candidate set after causal-path/latent exclusions. Its completeness domain differs from every observed-variable subset; it is exponential and does not license unrestricted targets."
    },
    {
      "id": "LLM-SEPARATION",
      "finding": "LLMPairwise uses variable descriptions, not data values, and has an optional provider path. It is a distinct information source from CI-based PC and remains outside the selected non-network graph service."
    }
  ],
  "claim_limits": [
    "Static primary-source review; no pgmpy installation or execution.",
    "Original source references listed by the package are not newly cited scholarly papers."
  ]
}
