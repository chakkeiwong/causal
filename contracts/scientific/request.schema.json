{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scientific request, design version 0.3.0-proposal",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "request_id", "operation", "model", "observation", "target", "sampling", "inference_request"],
  "properties": {
    "schema_version": {"const": "0.3.0-proposal"},
    "request_id": {"type": "string", "minLength": 1},
    "operation": {"enum": ["adjusted_mean", "encouragement_iv", "cohort_panel", "history_policy_value", "dynamic_shock_response", "controlled_latent", "discovery_query"]},
    "model": {"$ref": "#/$defs/artifact"},
    "observation": {"$ref": "#/$defs/artifact"},
    "target": {"$ref": "#/$defs/artifact"},
    "sampling": {"$ref": "#/$defs/artifact"},
    "inference_request": {"enum": ["none", "confidence_set", "posterior_credible_set"]}
  },
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "role"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "role": {"type": "string", "minLength": 1}
      }
    }
  }
}
