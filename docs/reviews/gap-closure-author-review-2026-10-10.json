  "gap_dispositions": {
    "G1": {
      "scholarly": "Closed: versioned explicit method, interpretable inference description, both consumer paths and serialization, regression against archived V6.1",
      "capability": "Reporting defect repaired. Regular interval coverage remains adverse; no metadata-based statistical promotion.",
      "remaining": "Adverse regular calibration remains; correct reporting is not a statistical repair."
    },
    "G2": {
      "scholarly": "Closed at declared moment-model scope: analytic global ellipsoid enclosure, primitive inclusion proof, retained and fresh comparisons, undercoverage arms",
      "capability": "Stronger designs are narrower in the retained comparison. Weak/singular designs remain largely whole-line. Useful individual contrast from the old singular mean restrictions is unresolved without new information.",
      "remaining": "D01: old singular mean restrictions remain uninformative; broader calibration and rigorous numerical enclosure remain open."
    },
    "G3": {
      "scholarly": "Closed for one audited 15-parameter model and finite observable-policy library: identification, joint likelihood, 15 derivatives, Gaussian/particle/value comparisons, fitted uncertainty, boundary and stable-domain/audit follow-up",
      "capability": "Research support for the selected model, particularly the 640-audit reference; 95/100 cover with wide MC uncertainty. General nonlinear identification, full belief-policy optimization, uniform calibration and global numerical certification remain open.",
      "remaining": "D02: general nonlinear identification, full belief-policy optimization, uniform calibration and global numerical certification remain open."
    },
    "G4": {
      "scholarly": "Closed for a finite Gaussian temporal class: simultaneous observed covariance region, conservative all-class projection, exact observational-equivalence witness and information arm",
      "capability": "Broad latent output correctly remains whole-line. Valid strong encouragement gives finite outer sets; false exclusions severely fail. Sharp or useful large-PAG confidence and general dependent-history inference remain open.",
      "remaining": "D03: useful general PAG confidence and dependent-history extensions require new arguments and information."
    },
    "G5": {
      "scholarly": "Closed for independent paired trajectories with one persistent map, known-inclusion outcome audits and externally known symmetric label error; adverse aliases, false facts and selection retained",
      "capability": "Useful finite pair-level intervals at exact correctness-count singularity require the additional linked-outcome information. Unknown label/audit bias, shared calendars, endogenous matching and many-to-many allocation remain unsupported.",
      "remaining": "D04/D05: unknown audit or semantic errors, endogenous/many-to-many maps and shared calendar shocks remain unsupported."
    },
    "G6": {
      "scholarly": "Closed for the selected dependent learner, clock-checked materialization, two-pass score streaming, atomic recovery, three journeys and 32 matched complete runs",
      "capability": "Explicit conditional learner support and local recovery are demonstrated. Fitting matrices still materialize; general out-of-core learners, multi-host service levels, analyst savings and accepted adoption are not established.",
      "remaining": "D06/D07/D08: arbitrary learners, general out-of-core fitting, multi-host service levels, independent and bank acceptance and measured savings remain open."
    }
  },
