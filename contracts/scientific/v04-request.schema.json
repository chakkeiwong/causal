{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded scientific request v0.4",
  "type": "object", "additionalProperties": false,
  "required": ["version","id","operation","variables","model","observation","population","sampling","target","data"],
  "properties": {
    "version": {"const":"0.4"}, "id":{"type":"string","minLength":1},
    "operation":{"enum":["dynamic_response","history_value","latent_value","graph_effect","temporal_graph_effect"]},
    "variables":{"type":"array","minItems":2,"items":{"type":"object","additionalProperties":false,"required":["name","support","unit","role"],"properties":{
      "name":{"type":"string"},"support":{"enum":["real","binary","finite"]},"unit":{"type":"string"},"role":{"enum":["action","outcome","instrument","control","signal","reward"]}}}},
    "model":{"type":"object","additionalProperties":false,"required":["regime","assumptions"],"properties":{
      "regime":{"enum":["A-G","A-I","B-H","B-L","C-G","C-T"]},"assumptions":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
      "family":{"type":"string"},"hidden_states":{"type":"integer","minimum":1},"max_lag":{"type":"integer","minimum":0},"time_order":{"type":["array","null"],"items":{"type":"integer"}}}},
    "observation":{"type":"object","additionalProperties":false,"required":["availability","clock_unit","step","revision","view_sha256"],"properties":{
      "availability":{"enum":["strict_before_decision","inclusive"]},"clock_unit":{"type":"string"},"step":{"type":"number","exclusiveMinimum":0},
      "revision":{"const":"latest_eligible_before_event_filter"},"view_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},
    "population":{"type":"object","additionalProperties":false,"required":["unit","weight_role","definition"],"properties":{
      "unit":{"type":"string"},"weight_role":{"enum":["population","propensity","resampling"]},"definition":{"type":"string"}}},
    "sampling":{"type":"object","additionalProperties":false,"required":["kind","independent_unit","fold_unit"],"properties":{
      "kind":{"enum":["iid_rows","iid_trajectories","time_series"]},"independent_unit":{"type":["string","null"]},"fold_unit":{"enum":["trajectory","separated_time_blocks","none"]}}},
    "target":{"type":"object","additionalProperties":false,"required":["action","outcomes","horizons","selection","contrast","normalization"],"properties":{
      "action":{"type":"string"},"outcomes":{"type":"array","minItems":1,"items":{"type":"string"}},
      "horizons":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"integer","minimum":0}},
      "selection":{"enum":["fixed","learned"]},"contrast":{"type":"string"},"normalization":{"type":"string"},
      "reference_policy":{"type":"array","items":{"type":"number","minimum":0,"maximum":1}},"evaluation_policy":{"type":"array","items":{"type":"number","minimum":0,"maximum":1}}}},
    "data":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"columns":{"type":"array","items":{"type":"string"}}}}
  }
}
