  "scientific_qualification": {
    "id": "lmtp",
    "role": "Modified/stochastic longitudinal policy estimator reference",
    "input": "Wide ordered treatment/covariate/outcome histories, a shift rule or shifted data, censoring/competing events, folds, sampling weights and optional cluster ID.",
    "output": "TMLE/SDR policy mean, noncumulative density-ratio estimates and sequential regression fits.",
    "assumptions": "Consistency, appropriate sequential exchangeability, support for the shifted law and adequate nuisance rates; finite memory k requires its own history-sufficiency argument.",
    "adapter_rule": "Reject missing treatment under the documented capability matrix. Distinguish risk-ratio ipsi from odds tilting: at e=P(A=1|H), ipsi(delta) gives delta*e for delta<=1 and 1-(1-e)/delta for delta>1. Preserve mtp, shifted-overrides-shift and exact event/censoring interpretation.",
    "acceptance_test": "For e=.2, delta=.5 gives .1 and delta=2 gives .6, versus odds-tilt values 1/9 and 1/3. Compare the declared policy mean to finite trajectory integration, including competing events and sampling weights.",
