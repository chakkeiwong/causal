{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "problem_id": {
      "type": "string",
      "minLength": 1
    },
    "revision_id": {
      "type": "string",
      "minLength": 1
    },
    "prior_revision_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision_reason": {
      "type": "string",
      "minLength": 1
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "DAG",
              "ADMG",
              "CPDAG",
              "PAG"
            ]
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "left": {
                  "type": "string",
                  "minLength": 1
                },
                "right": {
                  "type": "string",
                  "minLength": 1
                },
                "left_mark": {
                  "enum": [
                    "tail",
                    "arrow",
                    "circle"
                  ]
                },
                "right_mark": {
                  "enum": [
                    "tail",
                    "arrow",
                    "circle"
                  ]
                },
                "status": {
                  "enum": [
                    "possible",
                    "required"
                  ]
                },
                "evidence_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "counterevidence": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": [
                        "not_searched",
                        "none_in_declared_scope",
                        "reported"
                      ]
                    },
                    "scope": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence_refs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 0,
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "status",
                    "scope",
                    "evidence_refs"
                  ],
                  "additionalProperties": false
                },
                "review": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": [
                        "unreviewed",
                        "accepted_assumption",
                        "rejected",
                        "synthetic_fixture"
                      ]
                    },
                    "reviewer": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "minLength": 1
                    }
                  },
                  "required": [
                    "status",
                    "reviewer"
                  ],
                  "additionalProperties": false
                },
                "model_score": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "meaning": {
                          "const": "uncalibrated_model_response"
                        },
                        "model_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "prompt_sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      },
                      "required": [
                        "value",
                        "meaning",
                        "model_id",
                        "prompt_sha256"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "id",
                "left",
                "right",
                "left_mark",
                "right_mark",
                "status",
                "evidence_refs",
                "counterevidence",
                "review",
                "model_score"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "forbidden_directions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": [
                "source",
                "target",
                "evidence_refs"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "assumption_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "estimand_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "kind",
          "nodes",
          "edges",
          "forbidden_directions",
          "assumption_ids",
          "estimand_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "problem_id",
    "revision_id",
    "prior_revision_sha256",
    "revision_reason",
    "models"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:causalbank:la02:diagram-schema.json",
  "title": "LA02 diagram-schema.json"
}
