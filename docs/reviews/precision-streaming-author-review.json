  "blocking_findings": [],
  "gap_dispositions": {
    "D01": {
      "scholarly_and_capability": "Singular mean/count linkage remains uninformative for an individual contrast; V10 adds no outcome-linked information.",
      "remaining": "Representative linked outcomes or a newly identified likelihood and cost/precision comparison."
    },
    "D02": {
      "scholarly_and_capability": "Selected16 nonlinear evidence is inherited; streaming linear pilots do not generalize private-state policy inference.",
      "remaining": "Model-specific identification, policy information, audit rates and numerical/value checks."
    },
    "D03": {
      "scholarly_and_capability": "Finite supplied-information Gaussian effects remain the limit; no arbitrary PAG retention result follows.",
      "remaining": "Class-retention proof, observed-law uncertainty, structural bounds and justified extra information."
    },
    "D04": {
      "scholarly_and_capability": "Origin-swap and representative-audit premises stay conditional. Numeric declarations did not detect false exogeneity.",
      "remaining": "Source and audit-truth owners, validated selection law and an identified changed-observation model."
    },
    "D05": {
      "scholarly_and_capability": "Earlier pair/calendar derivation and adverse finite design remain; V10 does not change that experiment.",
      "remaining": "Independent challenge and registered joint-rate/window/boundary study for any new sampling law."
    },
    "D06": {
      "scholarly_and_capability": "A fixed-dictionary independent streaming pilot now matches dense tuning and inference at tested conditions. General learners and arbitrary out-of-core execution remain unsupported.",
      "remaining": "Learner-specific rates, approximation, covariance and numerical qualification."
    },
    "D07": {
      "scholarly_and_capability": "The large selected pilot route lowers complete local memory; elapsed time has no consistent advantage.",
      "remaining": "Target-platform owner, frozen workload/fault protocol, recovery and measured total cost."
    },
    "D08": {
      "scholarly_and_capability": "Local references and external protocols are prepared; no independent, bank, interface or workflow acceptance occurred.",
      "remaining": "Named participants, authentic inputs and signed results under the external protocol."
    },
    "D09": {
      "scholarly_and_capability": "The registered precision investigation is complete, including selected paired pilot evidence and adverse cells. A general calibration repair is not established.",
      "remaining": "A derived correction or changed design, registered afresh; retain small-audit, persistence, near-rank and false-exogeneity failures."
    },
    "D10": {
      "scholarly_and_capability": "Larger pilot history and financial interval widths are measured synthetically, not priced. Eightfold has no demonstrated gain over fourfold.",
      "remaining": "Bank precision threshold, invariant history feasibility, real audit/gold/pilot prices and matched held-out value."
    }
  },
