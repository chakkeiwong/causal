{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Scientific vector, curve, set and policy result v0.4",
  "type":"object","additionalProperties":false,
  "required":["version","request_id","request_sha256","kind","axes","units","estimate","covariance","uncertainty","graph","numerical_error","scope"],
  "properties":{
    "version":{"const":"0.4"},"request_id":{"type":"string"},"request_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "kind":{"enum":["scalar_effect","vector_effect","response_curve","effect_outer_set","policy_value_contrast","graph_response_set"]},
    "axes":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["name","labels"],"properties":{"name":{"type":"string"},"labels":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":["string","number"]}}}}},
    "units":{"type":"array","items":{"type":"string"}},"estimate":{"type":["array","null"],"items":{"type":"number"}},
    "covariance":{"type":["array","null"],"items":{"type":"array","items":{"type":"number"}}},
    "numerical_error":{"type":["array","null"],"items":{"type":"number","minimum":0}},
    "uncertainty":{"anyOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["kind","level","coverage","method","coordinate_sets"],"properties":{
      "kind":{"enum":["joint_confidence_set","pointwise_confidence_set","posterior_credible_set","sensitivity_set"]},
      "level":{"type":["number","null"],"exclusiveMinimum":0,"exclusiveMaximum":1},
      "coverage":{"enum":["simultaneous","pointwise","posterior","none"]},"method":{"type":"string"},
      "coordinate_sets":{"type":"array","items":{"type":"array","items":{"type":"array","minItems":2,"maxItems":2,"items":{"type":["number","null"]}}}}}}]},
    "graph":{"anyOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["kind","nodes","marks","models"],"properties":{
      "kind":{"enum":["DAG_set","CPDAG","PAG","temporal_coefficient_box"]},"nodes":{"type":"array","items":{"type":"string"}},"marks":{"type":"array","items":{"enum":["tail","arrow","circle","zero_or_nonzero","present"]}},
      "models":{"type":"array","items":{"type":"array","items":{"type":"array","items":{"type":"number"}}}}}}]},
    "scope":{"type":"object","additionalProperties":false,"required":["computation","identification","inference","assumptions","limitations"],"properties":{
      "computation":{"enum":["completed","failed","unsupported"]},"identification":{"enum":["conditional_functional","conditional_model_set","unresolved"]},
      "inference":{"enum":["exact_model_conditional","asymptotic_model_conditional","unavailable"]},"assumptions":{"type":"array","items":{"type":"string"}},"limitations":{"type":"array","items":{"type":"string"}}}}
  }
}
