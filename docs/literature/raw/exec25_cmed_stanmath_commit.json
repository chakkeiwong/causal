[{"sha":"65b6f98710fe7e542d501b34e473798276cb2b86","node_id":"C_kwDOAknC2NoAKDY1YjZmOTg3MTBmZTdlNTQyZDUwMWIzNGU0NzM3OTgyNzZjYjJiODY","commit":{"author":{"name":"Jachym.Barvinek","email":"jachym.barvinek@alza.cz","date":"2026-10-05T23:39:33Z"},"committer":{"name":"Jachym.Barvinek","email":"jachym.barvinek@alza.cz","date":"2026-10-05T23:39:33Z"},"message":"GLMs: dot_product where multiply would turn a product into a scalar\n\nWith a column-vector x (one attribute), multiply(x^T, theta_derivative)\nis a dot product and its scalar result cannot be assigned to the beta\npartials; this broke the expression tests of normal_id_glm_lpdf, whose\nStan signatures take x as a vector. Store dot_product(...) in the single\npartial. In categorical_logit_glm_lpmf a row-vector x gives the same\nshape with a column-vector beta (linear predictor) and a row-vector beta\n(x partial).","tree":{"sha":"621a47dcba8818a4a146cec473b27c4d3cb25306","url":"https://api.github.com/repos/stan-dev/math/git/trees/621a47dcba8818a4a146cec473b27c4d3cb25306"},"url":"https://api.github.com/repos/stan-dev/math/git/commits/65b6f98710fe7e542d501b34e473798276cb2b86","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/stan-dev/math/commits/65b6f98710fe7e542d501b34e473798276cb2b86","html_url":"https://github.com/stan-dev/math/commit/65b6f98710fe7e542d501b34e473798276cb2b86","comments_url":"https://api.github.com/repos/stan-dev/math/commits/65b6f98710fe7e542d501b34e473798276cb2b86/comments","author":null,"committer":null,"parents":[{"sha":"d8edb729cbb42eb40f0c3cd30cd78eabd6a5b620","url":"https://api.github.com/repos/stan-dev/math/commits/d8edb729cbb42eb40f0c3cd30cd78eabd6a5b620","html_url":"https://github.com/stan-dev/math/commit/d8edb729cbb42eb40f0c3cd30cd78eabd6a5b620"}]}]