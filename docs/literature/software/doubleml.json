  "scientific_qualification": {
    "id": "doubleml",
    "role": "Orthogonal score and inference reference",
    "input": "Outcome, treatment, covariates, optional instruments and explicit cluster variables; separate static or staggered-adoption panel schema.",
    "output": "Specified score-model coefficient and inference; data containers alone return no causal effect.",
    "assumptions": "The selected PLR/PLIV/IRM/IIVM or panel score matches the identified target, nuisance rates and sampling structure.",
    "adapter_rule": "Do not treat DoubleMLPanelData as an arbitrary trajectory container. Default static_panel=False treats d as first-treatment timing; constructor permits only one treatment column. Distinguish clustered scores from general time-series inference and explicitly list adjustment columns.",
    "acceptance_test": "Round-trip treatment-date and static-treatment examples without target change; reject two treatment columns and mixed cohort/action encoding. Compare a selected orthogonal score with its finite-law remainder and cluster-level splitting.",
