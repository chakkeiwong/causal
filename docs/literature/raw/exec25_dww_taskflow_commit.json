[{"sha":"57c182989e03f2de3c022175f80e2afe0013a7d3","node_id":"C_kwDOB8Cx9toAKDU3YzE4Mjk4OWUwM2YyZGUzYzAyMjE3NWY4MGUyYWZlMDAxM2E3ZDM","commit":{"author":{"name":"Arthur031221","email":"levi74108520963@gmail.com","date":"2026-09-29T00:00:52Z"},"committer":{"name":"Arthur031221","email":"levi74108520963@gmail.com","date":"2026-09-29T00:00:52Z"},"message":"Treat a non-positive count in fill_n and generate_n as empty\n\nstd::fill_n and std::generate_n do nothing when the count is zero or\nnegative. The parallel versions converted the count straight to size_t,\nso a negative count became a huge element count and, with more than one\nworker, the tasks wrote past the end of the range.\n\nClamp the count to zero before converting it, and add tests for counts\nof 0, -1 and -1000 with 1 to 4 workers and each partitioner.","tree":{"sha":"3563f920968eb693aaf8c8effa669b5d37f36582","url":"https://api.github.com/repos/taskflow/taskflow/git/trees/3563f920968eb693aaf8c8effa669b5d37f36582"},"url":"https://api.github.com/repos/taskflow/taskflow/git/commits/57c182989e03f2de3c022175f80e2afe0013a7d3","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/taskflow/taskflow/commits/57c182989e03f2de3c022175f80e2afe0013a7d3","html_url":"https://github.com/taskflow/taskflow/commit/57c182989e03f2de3c022175f80e2afe0013a7d3","comments_url":"https://api.github.com/repos/taskflow/taskflow/commits/57c182989e03f2de3c022175f80e2afe0013a7d3/comments","author":{"login":"Arthur031221","id":124417490,"node_id":"U_kgDOB2p10g","avatar_url":"https://avatars.githubusercontent.com/u/124417490?v=4","gravatar_id":"","url":"https://api.github.com/users/Arthur031221","html_url":"https://github.com/Arthur031221","followers_url":"https://api.github.com/users/Arthur031221/followers","following_url":"https://api.github.com/users/Arthur031221/following{/other_user}","gists_url":"https://api.github.com/users/Arthur03