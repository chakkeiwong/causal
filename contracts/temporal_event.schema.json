{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "temporal_event 0.1.0",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "entity_id": {
      "type": "string",
      "minLength": 1
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "event_at": {
      "type": "string",
      "format": "date-time"
    },
    "available_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_at": {
      "type": "string",
      "format": "date-time"
    },
    "role": {
      "enum": [
        "historical_covariate",
        "known_future_schedule",
        "assignment",
        "receipt",
        "outcome",
        "censoring"
      ]
    },
    "value": {
      "type": [
        "number",
        "string",
        "boolean",
        "null"
      ]
    },
    "missingness": {
      "enum": [
        "observed",
        "missing",
        "structural",
        "not_yet_available"
      ]
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "transform_version": {
      "type": "string",
      "minLength": 1
    },
    "entity_link_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "entity_id",
    "episode_id",
    "event_at",
    "available_at",
    "recorded_at",
    "decision_at",
    "role",
    "value",
    "missingness",
    "unit",
    "source_ref",
    "transform_version",
    "entity_link_version"
  ]
}
