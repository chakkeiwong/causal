{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "effect_result 0.1.0",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "study_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scientific_status": {
      "enum": [
        "identified_under_assumptions",
        "partially_identified",
        "unsupported",
        "not_identified"
      ]
    },
    "evidence_class": {
      "enum": [
        "synthetic",
        "observational_study",
        "experiment",
        "model_conditional"
      ]
    },
    "estimate": {
      "type": [
        "number",
        "null"
      ]
    },
    "interval": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "interval_kind": {
      "enum": [
        "confidence",
        "credible",
        "identified_set",
        "none"
      ]
    },
    "uncertainty_method": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "contrast_direction": {
      "type": "string",
      "minLength": 1
    },
    "n_independent_units": {
      "type": "integer",
      "minimum": 0
    },
    "diagnostics_ref": {
      "type": "string",
      "minLength": 1
    },
    "assumption_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "study_id",
    "study_sha256",
    "scientific_status",
    "evidence_class",
    "estimate",
    "interval",
    "interval_kind",
    "uncertainty_method",
    "unit",
    "contrast_direction",
    "n_independent_units",
    "diagnostics_ref",
    "assumption_ids",
    "limitations",
    "artifact_sha256"
  ]
}
