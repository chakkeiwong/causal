[{"sha":"7a133bf3288ce02af4f74b91592f05de8d3d93ee","node_id":"C_kwDOHf_9TNoAKDdhMTMzYmYzMjg4Y2UwMmFmNGY3NGI5MTU5MmYwNWRlOGQzZDkzZWU","commit":{"author":{"name":"Wenbo Gong","email":"GloveV659248@hotmail.com","date":"2026-10-07T22:27:27Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-10-07T22:27:27Z"},"message":"Remove redundant CodeQL workflow (default setup already scans the repo) (#168)\n\nRemove redundant CodeQL workflow\n\nThe repository has GitHub's CodeQL default setup enabled, which already scans Python and\nGitHub Actions on pushes and pull requests. GitHub rejects SARIF uploads from advanced\nCodeQL workflows while default setup is enabled (\"CodeQL analyses from advanced\nconfigurations cannot be processed when the default setup is enabled\"), so this workflow\nhas failed on every run. It also pins the retired codeql-action v2.\n\nCo-authored-by: Claude Opus 5.5 <noreply@anthropic.com>","tree":{"sha":"96be28ee23c645aba2d60e9c55e93a4868d05799","url":"https://api.github.com/repos/microsoft/causica/git/trees/96be28ee23c645aba2d60e9c55e93a4868d05799"},"url":"https://api.github.com/repos/microsoft/causica/git/commits/7a133bf3288ce02af4f74b91592f05de8d3d93ee","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqxsdPCRC1aQ7uu5UhlAAAgo4QAEgCN72lMlDRYRtLIzgIwBFQ\n+zC3oogviPwXnMn7AF9wkH5JiILcLLp6E0CmlDAQYysioyw+MQjL6MC+kd/fhT80\nxwnlrfsBp653s47ViFrvua6EqGY3ulu6H0yaStTzzsDLTw6yli6ryq/nmQc6BOy/\nITHG7qq8TUCXLnShAOyr1tIJIR8gWdJRasmnD7y+RhHJdX9rCww7+S0k/Kk7YhNI\nu6hUFU1Kbyz4KWzd4cYbQht+jedrxNxit8VDoDxP0WIqso/Y/55JQrQ0R7jUe4Sz\n+M5DpD1mMa/m3/U5DimAFjkX22niTgzmXrQ0Yzw0z6ec95YNxnYt2kV0x7NrYZw3\njGluXORyGs0OMbgSo/MR3m+6T7WJQQTiRtaJQpF0qzXE8BFXIYsESJ62WaF3okdK\nDhA+xnRmyCTBORdpbG7nxrbW9EJDQlurKHQvtddqaZqXNkTte4zP2SPUpxORfCuQ\nzLHMzaw92VBz9Mr9hZbDw8gD49XRAYkabUDoyJDGJf6Ms8xVRWkSAY/8NJabNfVB\nbkB+KOFydnslqS6BQXKuQPGwLUHty7KtzEc+D/jdlSjmZZxSQkgAgiP3t7s7Z+6p\nspkw1YNVGwD4Js1DTFgNOdtvLl7wsxC5A8GUyIm1CL+/V64+wjdV5CJhPJLlPxAC\na+5HFyzyaY8FQ4OlNX4c\n=Sr85\n-----END PGP SIGNATURE-----\n","payload":"tree 96be28ee23c645aba2d60e9c55e93a4868d05799\nparent c3b7dd2b09fe0efb543adb05b89716d0dbdee780\nauthor Wenbo Gong <GloveV659248@hotmail.com> 1791412047 +0100\ncommitter GitHub <noreply@github.com> 1791412047 +0800\n\nRemove redundant CodeQL workflow (default setup already scans the repo) (#168)\n\nRemove redundant CodeQL workflow\n\nThe repository has GitHub's CodeQL default setup enabled, which already scans Python and\nGitHub Actions on pushes and pull requests. GitHub rejects SARIF uploads from advanced\nCodeQL workflows while default setup is enabled (\"CodeQL analyses from advanced\nconfigurations cannot be processed when the default setup is enabled\"), so this workflow\nhas failed on every run. It also pins the retired codeql-action v2.\n\nCo-authored-by: Claude Opus 5.5 <noreply@anthropic.com>","verified_at":"2026-10-07T22:27:28Z"}},"url":"https://api.github.com/repos/microsoft/causica/commits/7a133bf3288ce02af4f74b91592f05de8d3d93ee","html_url":"https://github.com/microsoft/causica/commit/7a133bf3288ce02af4f74b91592f05de8d3d93ee","comments_url":"https://api.github.com/repos/microsoft/causica/commits/7a133bf3288ce02af4f74b91592f05de8d3d93ee/comments","author":{"login":"WenboGong","id":15999507,"node_id":"MDQ6VXNlcjE1OTk5NTA3","avatar_url":"https://avatars.githubusercontent.com/u/15999507?v=4","gravatar_id":"","url":"https://api.github.com/users/WenboGong","html_url":"https://github.com/WenboGong","followers_url":"https://api.github.com/users/WenboGong/followers","following_url":"https://api.github.com/users/WenboGong/following{/other_user}","gists_url":"https://api.github.com/users/WenboGong/gists{/gist_id}","starred_url":"https://api.github.com/users/WenboGong/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/WenboGong/subscriptions","organizations_url":"https://api.github.com/users/WenboGong/orgs","repos_url":"https: