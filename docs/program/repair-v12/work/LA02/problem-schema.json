{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "problem_id": {
      "type": "string",
      "minLength": 1
    },
    "provenance_mode": {
      "enum": [
        "synthetic_fixture",
        "proposed_bank_analysis"
      ]
    },
    "business_question": {
      "type": "string",
      "minLength": 1
    },
    "decision_owner": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "unit_of_analysis": {
      "type": "string",
      "minLength": 1
    },
    "clock": {
      "type": "object",
      "properties": {
        "unit": {
          "const": "days"
        },
        "origin_definition": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "unit",
        "origin_definition"
      ],
      "additionalProperties": false
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "measurement": {
            "enum": [
              "observed",
              "latent",
              "derived"
            ]
          },
          "event_time": {
            "type": "number"
          },
          "available_time": {
            "type": [
              "number",
              "null"
            ]
          },
          "derived_from": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "selection_indicator": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "definition",
          "unit",
          "measurement",
          "event_time",
          "available_time",
          "derived_from",
          "selection_indicator"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "decision_points": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "time": {
            "type": "number"
          },
          "information_set": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "time",
          "information_set"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "estimand_alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "enum": [
              "ATE",
              "ATT",
              "overlap_ATE",
              "trimmed_ATE",
              "policy_value",
              "policy_contrast",
              "population_mean"
            ]
          },
          "treatment": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "population": {
            "type": "string",
            "minLength": 1
          },
          "target_weight_rule": {
            "type": "string",
            "minLength": 1
          },
          "target_measure": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "population_uniform",
                  "treated_population",
                  "overlap_propensity",
                  "propensity_trimmed"
                ]
              },
              "trimming_bounds": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                ]
              }
            },
            "required": [
              "kind",
              "trimming_bounds"
            ],
            "additionalProperties": false
          },
          "population_condition": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "variable": {
                  "type": "string",
                  "minLength": 1
                },
                "operator": {
                  "enum": [
                    "eq",
                    "lt",
                    "le",
                    "gt",
                    "ge"
                  ]
                },
                "value": {
                  "type": [
                    "number",
                    "string"
                  ]
                }
              },
              "required": [
                "variable",
                "operator",
                "value"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "horizon": {
            "type": "object",
            "properties": {
              "origin": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "number"
              },
              "end": {
                "type": "number"
              }
            },
            "required": [
              "origin",
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "intervention": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "static",
                  "dynamic"
                ]
              },
              "actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "decision_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "variable": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": [
                        "number",
                        "string",
                        "null"
                      ]
                    },
                    "rule": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "variable": {
                              "type": "string",
                              "minLength": 1
                            },
                            "operator": {
                              "enum": [
                                "eq",
                                "lt",
                                "le",
                                "gt",
                                "ge"
                              ]
                            },
                            "threshold": {
                              "type": "number"
                            },
                            "then_value": {
                              "type": [
                                "number",
                                "string"
                              ]
                            },
                            "else_value": {
                              "type": [
                                "number",
                                "string"
                              ]
                            }
                          },
                          "required": [
                            "variable",
                            "operator",
                            "threshold",
                            "then_value",
                            "else_value"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "depends_on": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 0,
                      "uniqueItems": true
                    },
                    "feasibility": {
                      "enum": [
                        "hypothetical",
                        "verified_by_owner",
                        "unknown",
                        "infeasible"
                      ]
                    },
                    "evidence_refs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "decision_id",
                    "variable",
                    "value",
                    "rule",
                    "depends_on",
                    "feasibility",
                    "evidence_refs"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "kind",
              "actions"
            ],
            "additionalProperties": false
          },
          "comparator": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "static",
                  "dynamic"
                ]
              },
              "actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "decision_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "variable": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": [
                        "number",
                        "string",
                        "null"
                      ]
                    },
                    "rule": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "variable": {
                              "type": "string",
                              "minLength": 1
                            },
                            "operator": {
                              "enum": [
                                "eq",
                                "lt",
                                "le",
                                "gt",
                                "ge"
                              ]
                            },
                            "threshold": {
                              "type": "number"
                            },
                            "then_value": {
                              "type": [
                                "number",
                                "string"
                              ]
                            },
                            "else_value": {
                              "type": [
                                "number",
                                "string"
                              ]
                            }
                          },
                          "required": [
                            "variable",
                            "operator",
                            "threshold",
                            "then_value",
                            "else_value"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "depends_on": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 0,
                      "uniqueItems": true
                    },
                    "feasibility": {
                      "enum": [
                        "hypothetical",
                        "verified_by_owner",
                        "unknown",
                        "infeasible"
                      ]
                    },
                    "evidence_refs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "decision_id",
                    "variable",
                    "value",
                    "rule",
                    "depends_on",
                    "feasibility",
                    "evidence_refs"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "kind",
              "actions"
            ],
            "additionalProperties": false
          },
          "loss": {
            "type": "object",
            "properties": {
              "definition": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "direction": {
                "enum": [
                  "minimize",
                  "maximize"
                ]
              },
              "discount_rule": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "definition",
              "unit",
              "direction",
              "discount_rule"
            ],
            "additionalProperties": false
          },
          "adjustment": {
            "type": "object",
            "properties": {
              "purpose": {
                "enum": [
                  "total_effect",
                  "policy_history",
                  "unspecified"
                ]
              },
              "variables": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "status": {
                "enum": [
                  "proposed",
                  "unknown",
                  "declared_for_fixture"
                ]
              }
            },
            "required": [
              "purpose",
              "variables",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "family",
          "treatment",
          "outcome",
          "population",
          "target_weight_rule",
          "target_measure",
          "population_condition",
          "horizon",
          "intervention",
          "comparator",
          "loss",
          "adjustment"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "resolution": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "ambiguous",
            "selected",
            "refused"
          ]
        },
        "selected_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "review": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "unreviewed",
                "accepted_assumption",
                "rejected",
                "synthetic_fixture"
              ]
            },
            "reviewer": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          },
          "required": [
            "status",
            "reviewer"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "status",
        "selected_id",
        "reason",
        "review"
      ],
      "additionalProperties": false
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "hypothesis",
              "accepted_assumption",
              "synthetic_fixture",
              "contradicted"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "review": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "unreviewed",
                  "accepted_assumption",
                  "rejected",
                  "synthetic_fixture"
                ]
              },
              "reviewer": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              }
            },
            "required": [
              "status",
              "reviewer"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "statement",
          "status",
          "evidence_refs",
          "review"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "primary_source",
              "expert_assertion",
              "observational_data",
              "experiment",
              "model_proposal",
              "project_synthetic_definition"
            ]
          },
          "source_identity": {
            "type": "string",
            "minLength": 1
          },
          "version_date": {
            "type": "string",
            "minLength": 1
          },
          "local_path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "anchor": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "source_identity",
          "version_date",
          "local_path",
          "sha256",
          "anchor",
          "claim"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "problem_id",
    "provenance_mode",
    "business_question",
    "decision_owner",
    "unit_of_analysis",
    "clock",
    "variables",
    "decision_points",
    "estimand_alternatives",
    "resolution",
    "assumptions",
    "evidence"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:causalbank:la02:problem-schema.json",
  "title": "LA02 problem-schema.json"
}
