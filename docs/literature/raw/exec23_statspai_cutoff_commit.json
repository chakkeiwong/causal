[{"sha":"35d5a4fbd05f1b90201c24d806df9b12f966e50d","node_id":"C_kwDOPTFLfNoAKDM1ZDVhNGZiZDA1ZjFiOTAyMDFjMjRkODA2ZGY5YjEyZjk2NmU1MGQ","commit":{"author":{"name":"Bryce Wang","email":"brycew6m@stanford.edu","date":"2026-10-07T15:30:14Z"},"committer":{"name":"Bryce Wang","email":"brycew6m@stanford.edu","date":"2026-10-07T15:30:14Z"},"message":"docs(examples): 401(k) DML notebook as a Chinese tutorial; agent parity review\n\nThe DoubleML / hdm 401(k) reproduction becomes a fourteen-section DML\ntutorial with prose and comments in Chinese: a hand-rolled cross-fitted\nPLR, the choice of controls and learners, IRM / ATTE and overlap,\nrepeated cross-fitting, shared-fold comparison with doubleml-for-py, the\nIIVM LATE of participation, and omitted-variable sensitivity. The\nnotebook ships its executed outputs; the README adds matplotlib to the\ninstall line.\n\nAlso adds the 2026-10-02 repository review of MCP, skills, agent\nmetadata and Stata / R evidence (docs/dev).\n\nRefs in the notebook checked against paper.bib (chernozhukov2018double,\nchernozhukov2016hdm, bach2022doubleml, chernozhukov2022long);\nChernozhukov & Hansen (2004) verified via the Crossref API and doi.org.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>","tree":{"sha":"8bd72fa51e5eb116e2d49bce1a169854f4cdd6bf","url":"https://api.github.com/repos/brycewang-stanford/StatsPAI/git/trees/8bd72fa51e5eb116e2d49bce1a169854f4cdd6bf"},"url":"https://api.github.com/repos/brycewang-stanford/StatsPAI/git/commits/35d5a4fbd05f1b90201c24d806df9b12f966e50d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/brycewang-stanford/StatsPAI/commits/35d5a4fbd05f1b90201c24d806df9b12f966e50d","html_url":"https://github.com/brycewang-stanford/StatsPAI/commit/35d5a4fbd05f1b90201c24d806df9b12f966e50d","comments_url":"https://api.github.com/repos/brycewang-stanford/StatsPAI/commits/35d5a4fbd05f1b90201c24d806df9b12f9