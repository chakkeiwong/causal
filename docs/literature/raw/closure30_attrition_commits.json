[{"sha":"162f979c44e5d28465d34ffe2d68b413b99ca3d5","node_id":"C_kwDOAqBPmdoAKDE2MmY5NzljNDRlNWQyODQ2NWQzNGZmZTJkNjhiNDEzYjk5Y2EzZDU","commit":{"author":{"name":"Alexander Coppock","email":"acoppock@users.noreply.github.com","date":"2026-09-21T00:32:56Z"},"committer":{"name":"Alexander Coppock","email":"acoppock@users.noreply.github.com","date":"2026-09-21T00:32:56Z"},"message":"Take the macOS dependencies from Posit Package Manager\n\nCRAN served part of its macOS arm64 R 4.6 binaries as zstd archives under\nthe .tgz name from 2026-09-17, estimatr 2.0.0 among them. The pak that\nsetup-r-dependencies installs reads gzip, bzip2, xz and zip but not zstd,\nso a macOS job dies at the dependency install with \"unknown archive type\"\n(r-lib/pkgdepends#485). Posit Package Manager still serves gzip builds of\nthe same versions.\n\nRevert once a released pak reads zstd.\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>","tree":{"sha":"3004d632c37425f2badea1670585b8db65ff54d3","url":"https://api.github.com/repos/acoppock/attrition/git/trees/3004d632c37425f2badea1670585b8db65ff54d3"},"url":"https://api.github.com/repos/acoppock/attrition/git/commits/162f979c44e5d28465d34ffe2d68b413b99ca3d5","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/acoppock/attrition/commits/162f979c44e5d28465d34ffe2d68b413b99ca3d5","html_url":"https://github.com/acoppock/attrition/commit/162f979c44e5d28465d34ffe2d68b413b99ca3d5","comments_url":"https://api.github.com/repos/acoppock/attrition/commits/162f979c44e5d28465d34ffe2d68b413b99ca3d5/comments","author":{"login":"acoppock","id":9171009,"node_id":"MDQ6VXNlcjkxNzEwMDk=","avatar_url":"https://avatars.githubusercontent.com/u/9171009?v=4","gravatar_id":"","url":"https://api.github.com/users/acoppock","html_url":"https://github.com/acoppock","followers_url":"https://api.github.com/users/acoppock/followers","following_url":"https://api.gi