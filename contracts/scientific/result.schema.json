{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scientific result, design version 0.3.0-proposal",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "request_id", "request_sha256", "operation", "computation", "identification", "estimate", "inference", "evidence_class"],
  "properties": {
    "schema_version": {"const": "0.3.0-proposal"},
    "request_id": {"type": "string", "minLength": 1},
    "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "operation": {"enum": ["adjusted_mean", "encouragement_iv", "cohort_panel", "history_policy_value", "dynamic_shock_response", "controlled_latent", "discovery_query"]},
    "computation": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"enum": ["completed", "timeout", "failed", "unsupported"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "identification": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "assumptions", "reason", "evidence"],
      "properties": {
        "status": {"enum": ["identified_functional", "identified_set", "outer_bound", "not_identified", "unresolved", "incompatible_specification"]},
        "assumptions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "reason": {"type": "string", "minLength": 1},
        "evidence": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]}
      }
    },
    "estimate": {"type": ["number", "null"]},
    "inference": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reason", "object", "evidence"],
      "properties": {
        "status": {"enum": ["not_requested", "available", "unavailable"]},
        "reason": {"type": "string", "minLength": 1},
        "evidence": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
        "object": {"anyOf": [{"$ref": "#/$defs/uncertainty"}, {"type": "null"}]}
      }
    },
    "evidence_class": {"enum": ["schema_fixture", "finite_exact_example", "synthetic_estimation", "bank_validation"]}
  },
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "role"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "uncertainty": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "level", "coverage_target", "method", "set"],
      "properties": {
        "kind": {"enum": ["confidence_set", "posterior_credible_set"]},
        "level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "coverage_target": {"enum": ["scalar_target", "identified_set", "model_conditional_parameter"]},
        "method": {"type": "string", "minLength": 1},
        "set": {"type": "array", "items": {"$ref": "#/$defs/interval"}}
      }
    },
    "interval": {
      "type": "object", "additionalProperties": false,
      "required": ["lower", "upper", "lower_closed", "upper_closed"],
      "properties": {
        "lower": {"type": ["number", "null"]},
        "upper": {"type": ["number", "null"]},
        "lower_closed": {"type": "boolean"},
        "upper_closed": {"type": "boolean"}
      }
    }
  }
}
