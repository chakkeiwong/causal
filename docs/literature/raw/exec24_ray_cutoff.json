[{"sha":"1331e57a55ef2c1ec31733b6b0d1ce77d610effe","node_id":"C_kwDOBEmZvdoAKDEzMzFlNTdhNTVlZjJjMWVjMzE3MzNiNmIwZDFjZTc3ZDYxMGVmZmU","commit":{"author":{"name":"Jeffrey Wang","email":"jeffreywang@anyscale.com","date":"2026-10-07T21:55:03Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-10-07T21:55:03Z"},"message":"[serve] Reset router backoff after successful FIFO assignments (#66799)\n\n## Problem\nA routing task can assign an older FIFO request while still owning\nanother request. After #66325, these successful assignments continued\nexponential backoff, slowing model composition.\n\n## Solution\nReset backoff after each successful assignment while preserving request\nownership and cancellation protections.\n\nSigned-off-by: Jeffrey Wang <jeffreywang@anyscale.com>","tree":{"sha":"f84ef6e8d26869211b0c7c6d16f38e106ba167ae","url":"https://api.github.com/repos/ray-project/ray/git/trees/f84ef6e8d26869211b0c7c6d16f38e106ba167ae"},"url":"https://api.github.com/repos/ray-project/ray/git/commits/1331e57a55ef2c1ec31733b6b0d1ce77d610effe","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqxr+3CRC1aQ7uu5UhlAAAED4QACfYPxCfjR2f/wqiN7zs1Ioe\nnaoT5t0cE4daohNPtscz3Evykbd7/2shJ/h6kFYkAYuVu/ByFS/57c/CeUWfnCmg\n/kiL9sSqxq1+OPmJEytUx8yamxvHFjneggHRJUe1TjNuosFAvO2MV/LEIRBwf/NL\n6oAhZutENa5lW3o5Wq+BTX9JAMRvAlNaBhfHLlyyFBbg0xeApkQ4Vmy2E9O5MJhG\n2cnE3LoED1qFuH4UYX/KW+9FpPOLmO/cSVQ112IbVUZjPx/S+NUWa5NAqV8oQ3PF\n21tLvCpUAza1oHDa/QhAl20s3mUQaFs5uPNhvZyZlj+QIUYDlEr1kAspn5WZY0cS\nyCnn7DATYrWlJvMqT8qqhRUM1fhHmUBj+7zFUNM0CgV2w8JF8bPxg5KLUQTpI3sd\n8GLxHRgYdgRQUfGyV/pE6fBh7JKmrcZwZXEvrpQLrossMo00G/PQ71btMbOWZaBe\nskyZRsr9fV2OLz/JLuiiEmqNSQX/+L/8EFntQ0+UIWVaQzy7UmBgKihnDehDbqXI\nnRndn7y4C/wzgbGJXOgeYwYhr28hY6R0t7ACAm4Y4CKSvP3gZpWr6nqzZ+04DDpm\nnsj/V+q48yoARhQaExMrELBpdNliRGHDQaZ38gE691fq/B/Y5vRaha1UgdjX3f9T\nsQ8oDKmIRlZ+HE5JLB7h\n=QX5D\n-----END PGP SIGNATURE-----\n","payload":"tree f84ef6e8d26869211b0c7c6d16f38e106ba167ae\nparent 6a0f6b0cb167b1e8482bfbf459c0176a602441d0\nauthor Jeffrey Wang <jeffreywang@anyscale.com> 1791410103 -0700\ncommitter GitHub <noreply@github.com> 1791410103 +0000\n\n[serve] Reset router backoff after successful FIFO assignments (#66799)\n\n## Problem\nA routing task can assign an older FIFO request while still owning\nanother request. After #66325, these successful assignments continued\nexponential backoff, slowing model composition.\n\n## Solution\nReset backoff after each successful assignment while preserving request\nownership and cancellation protections.\n\nSigned-off-by: Jeffrey Wang <jeffreywang@anyscale.com>","verified_at":"2026-10-07T21:55:05Z"}},"url":"https://api.github.com/repos/ray-project/ray/commits/1331e57a55ef2c1ec31733b6b0d1ce77d610effe","html_url":"https://github.com/ray-project/ray/commit/1331e57a55ef2c1ec31733b6b0d1ce77d610effe","comments_url":"https://api.github.com/repos/ray-project/ray/commits/1331e57a55ef2c1ec31733b6b0d1ce77d610effe/comments","author":{"login":"jeffreywang88","id":248752665,"node_id":"U_kgDODtOqGQ","avatar_url":"https://avatars.githubusercontent.com/u/248752665?v=4","gravatar_id":"","url":"https://api.github.com/users/jeffreywang88","html_url":"https://github.com/jeffreywang88","followers_url":"https://api.github.com/users/jeffreywang88/followers","following_url":"https://api.github.com/users/jeffreywang88/following{/other_user}","gists_url":"https://api.github.com/users/jeffreywang88/gists{/gist_id}","starred_url":"https://api.github.com/users/jeffreywang88/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jeffreywang88/subscriptions","organizations_url":"https://api.github.com/users/jeffreywang88/orgs","repos_url":"https://api.github.com/users/jeffreywang88/repos","events_url":"https://api.github.com/users/jeffreywang88/events{/privacy}","received_events_url":"https://api.github.com/users/jeffreywang88/received_events","type":"User","user_view_type":"public","sit