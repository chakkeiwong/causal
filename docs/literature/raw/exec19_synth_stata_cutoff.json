[{"sha":"ae99fd1ed100e8f5ea38386f18f02e61a90956e6","node_id":"C_kwDOSQEDMdoAKGFlOTlmZDFlZDEwMGU4ZjVlYTM4Mzg2ZjE4ZjAyZTYxYTkwOTU2ZTY","commit":{"author":{"name":"Jens Hainmueller","email":"jhain@stanford.edu","date":"2026-04-30T15:57:51Z"},"committer":{"name":"Jens Hainmueller","email":"jhain@stanford.edu","date":"2026-04-30T15:57:51Z"},"message":"synth.sthlp: replace sysuse smoking with use smoking, clear\n\nPer Kit Baum: smoking.dta is not a Stata-bundled dataset, so\nsysuse smoking fails after a plain net install. The Examples block\nin synth.sthlp now uses 'use smoking, clear' and instructs users to\nrun 'net get synth' first if smoking.dta isn't in their cwd.\n\nCaught after the v0.0.8 release; rebuilding the SSC zip.\n\nCo-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>","tree":{"sha":"5c67d34753db04d95c85999173bf497739cbe56a","url":"https://api.github.com/repos/j-hai/synth-stata/git/trees/5c67d34753db04d95c85999173bf497739cbe56a"},"url":"https://api.github.com/repos/j-hai/synth-stata/git/commits/ae99fd1ed100e8f5ea38386f18f02e61a90956e6","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/j-hai/synth-stata/commits/ae99fd1ed100e8f5ea38386f18f02e61a90956e6","html_url":"https://github.com/j-hai/synth-stata/commit/ae99fd1ed100e8f5ea38386f18f02e61a90956e6","comments_url":"https://api.github.com/repos/j-hai/synth-stata/commits/ae99fd1ed100e8f5ea38386f18f02e61a90956e6/comments","author":{"login":"j-hai","id":115841204,"node_id":"U_kgDOBueYtA","avatar_url":"https://avatars.githubusercontent.com/u/115841204?v=4","gravatar_id":"","url":"https://api.github.com/users/j-hai","html_url":"https://github.com/j-hai","followers_url":"https://api.github.com/users/j-hai/followers","following_url":"https://api.github.com/users/j-hai/following{/other_user}","gists_url":"https://api.github.com/users/j-hai/gists{/gist_id}","starred_url":"https://api.github.com/