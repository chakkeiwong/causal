[{"sha":"03e6015a150086fea953a62349755d1059a0cd01","node_id":"C_kwDOSe-2mdoAKDAzZTYwMTVhMTUwMDg2ZmVhOTUzYTYyMzQ5NzU1ZDEwNTlhMGNkMDE","commit":{"author":{"name":"Yosuke Abe","email":"yosuke.abe0507@gmail.com","date":"2026-09-23T09:26:07Z"},"committer":{"name":"Yosuke Abe","email":"yosuke.abe0507@gmail.com","date":"2026-09-23T09:26:07Z"},"message":"fix: stop knitr from executing 'r = NULL' as an inline code chunk\n\npkgdown's article build failed on vignettes/articles/estimators.Rmd:\nknitr treats a backtick-code span starting with \"r\" followed by\nwhitespace as inline R code to evaluate, so `` `r = NULL` `` and\n`` `r = 4` `` -- meant as literal mentions of the r argument -- were\nparsed as R expressions `= NULL` and `= 4`, both invalid syntax.\nRemoving the space (`r=NULL`, `r=4`) keeps them as plain code spans.\nVerified with a full local pkgdown::build_site(); no other `` `r ...`\n`` spans exist in the built vignettes.\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>","tree":{"sha":"bbe9fa6d89b5cfb0b52a865f36b8bbb85a2508f8","url":"https://api.github.com/repos/yo5uke/coresynth/git/trees/bbe9fa6d89b5cfb0b52a865f36b8bbb85a2508f8"},"url":"https://api.github.com/repos/yo5uke/coresynth/git/commits/03e6015a150086fea953a62349755d1059a0cd01","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/yo5uke/coresynth/commits/03e6015a150086fea953a62349755d1059a0cd01","html_url":"https://github.com/yo5uke/coresynth/commit/03e6015a150086fea953a62349755d1059a0cd01","comments_url":"https://api.github.com/repos/yo5uke/coresynth/commits/03e6015a150086fea953a62349755d1059a0cd01/comments","author":{"login":"yo5uke","id":141737272,"node_id":"U_kgDOCHK9OA","avatar_url":"https://avatars.githubusercontent.com/u/141737272?v=4","gravatar_id":"","url":"https://api.github.com/users/yo5uke","html_url":"https://github.com/yo5uke","followers_url":"https://api.github.com/users/yo5uke